{
  "name": "flowpact",
  "version": "0.8.0",
  "description": "Data-flow linter for GitHub Actions: finds inputs, secrets and matrix values that arrive empty across reusable workflows and local actions.",
  "keywords": [
    "github-actions",
    "linter",
    "reusable-workflows",
    "workflow-call",
    "composite-actions",
    "matrix",
    "secrets",
    "static-analysis",
    "ci",
    "sarif",
    "semver",
    "contracts"
  ],
  "homepage": "https://rumankazi.github.io/flowpact",
  "bugs": {
    "url": "https://github.com/rumankazi/flowpact/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumankazi/flowpact.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Ruman Kazi",
  "type": "module",
  "bin": {
    "flowpact": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@flowpact/core": "workspace:*",
    "@flowpact/language-server": "workspace:*",
    "@flowpact/reporters": "workspace:*",
    "citty": "^0.2.2",
    "execa": "^10.1.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1"
  }
}
